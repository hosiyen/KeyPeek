<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Windows 11-idiom controls for the settings window. Everything paints from the
         Kp* tokens (UI/Themes/Overlay*.xaml), so light/dark come for free.
         Type scale: 20 page title / 15 card title / 13 body / 11.5 secondary. -->

    <sys:Double x:Key="KpFontTitle">20</sys:Double>
    <sys:Double x:Key="KpFontCardTitle">15</sys:Double>
    <sys:Double x:Key="KpFontBody">13</sys:Double>
    <sys:Double x:Key="KpFontSmall">11.5</sys:Double>

    <!-- ============ thin scrollbars ============ -->
    <Style x:Key="KpScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="B" Background="{DynamicResource KpTextFaint}"
                            CornerRadius="3" Margin="3,2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource KpTextDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource KpScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ text ============ -->
    <Style x:Key="KpPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource KpFontTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KpText}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="KpCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource KpFontCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KpText}" />
    </Style>
    <Style x:Key="KpBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource KpFontBody}" />
        <Setter Property="Foreground" Value="{DynamicResource KpTextBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="KpHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource KpFontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource KpTextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============ card ============ -->
    <Style x:Key="KpCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource KpSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KpLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource KpRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A dashboard card: same surface as KpCard, but it sits in a wrapping row, so its
         margin goes on the right as well as the bottom. -->
    <Style x:Key="KpStatCard" TargetType="Border" BasedOn="{StaticResource KpCard}">
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="16,14,16,12" />
    </Style>

    <!-- Rounded tint behind a card's glyph. Gives each card one spot of colour without
         painting the whole card, which would compete with the numbers. -->
    <Style x:Key="KpIconChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource KpAccentSubtle}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- The number IS the message: read at a glance, with the label underneath as the
         caption rather than a heading above a sentence. -->
    <Style x:Key="KpStatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KpText}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="KpStatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource KpTextDim}" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!-- ============ buttons ============ -->
    <Style x:Key="KpButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource KpText}" />
        <Setter Property="FontSize" Value="{StaticResource KpFontBody}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{DynamicResource KpSurface2}"
                            BorderBrush="{DynamicResource KpLine}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource KpHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource KpAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource KpTextDisabled}" />
                            <Setter TargetName="B" Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KpButtonPrimary" TargetType="Button" BasedOn="{StaticResource KpButton}">
        <Setter Property="Foreground" Value="{DynamicResource KpOnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{DynamicResource KpAccent}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- link-looking button for footers -->
    <Style x:Key="KpLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource KpAccent}" />
        <Setter Property="FontSize" Value="{StaticResource KpFontSmall}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}" TextDecorations="Underline" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ toggle switch (Win11) ============ -->
    <Style x:Key="KpToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Focus" Background="Transparent" Padding="2" CornerRadius="12">
                        <Grid Width="40" Height="20">
                            <Border x:Name="Track" CornerRadius="10"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource KpTextDim}" BorderThickness="1.4" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource KpTextDim}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource KpAccent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource KpAccent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource KpOnAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource KpAccent}" />
                            <Setter TargetName="Focus" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ key-cap toggle chip (trigger keys) ============ -->
    <Style x:Key="KpCapToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" Background="{DynamicResource KpCapBg}"
                            BorderBrush="{DynamicResource KpCapBorder}" BorderThickness="1,1,1,2.5"
                            CornerRadius="6" Padding="16,5,16,6" SnapsToDevicePixels="True">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{DynamicResource KpCapText}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource KpAccent}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource KpAccent}" />
                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource KpOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource KpAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ text input ============ -->
    <Style x:Key="KpTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource KpText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource KpText}" />
        <Setter Property="FontSize" Value="{StaticResource KpFontBody}" />
        <Setter Property="Padding" Value="8,5" />
        <!-- Defaults, not hardcodes: the template used to paint its own surface and border
             regardless, so a text box placed inside a rounded container (the search pill)
             drew a second square-cornered box inside it. -->
        <Setter Property="Background" Value="{DynamicResource KpSurface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KpLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource KpAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ slider ============ -->
    <Style x:Key="KpSlider" TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Height="24">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource KpSurface2}"
                                BorderBrush="{DynamicResource KpLine}" BorderThickness="1" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2"
                                                    Background="{DynamicResource KpAccent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="{DynamicResource KpAccent}" />
                                                <Ellipse Fill="{DynamicResource KpSurface}" Margin="5" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ left nav item ============ -->
    <Style x:Key="KpNavItem" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                            Margin="6,1" Padding="8,9" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border x:Name="Bar" DockPanel.Dock="Left" Width="3" CornerRadius="1.5"
                                    Background="Transparent" Margin="0,2,9,2" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource KpHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource KpSurface}" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource KpAccent}" />
                            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource KpAccent}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ library sidebar item ============ -->
    <Style x:Key="KpAppItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                            Margin="4,1" Padding="6,6" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border x:Name="Bar" DockPanel.Dock="Left" Width="3" CornerRadius="1.5"
                                    Background="Transparent" Margin="0,1,7,1" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource KpHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource KpSurface2}" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource KpAccent}" />
                            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ expander (Advanced) ============ -->
    <Style x:Key="KpExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource KpTextBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderBtn" Cursor="Hand" Focusable="True"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chev" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource KpTextDim}" Margin="0,0,8,0" />
                                            <ContentPresenter />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chev" Property="Text" Value="&#xE70E;" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="18,4,0,4" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tooltips readable in both themes -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource KpSurface2}" />
        <Setter Property="Foreground" Value="{DynamicResource KpText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KpLine}" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
</ResourceDictionary>
