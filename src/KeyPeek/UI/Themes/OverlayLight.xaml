<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- KeyPeek light palette. Same keys as OverlayDark.xaml, light values. -->

    <!-- surfaces -->
    <!-- The page sits a shade below its cards: at #F2F2F6 with white cards the whole window
         read as one flat sheet, which is what "light theme looks unfinished" usually means. -->
    <SolidColorBrush x:Key="KpBg" Color="#FFEAEAF0" />
    <SolidColorBrush x:Key="KpSurface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="KpSurface2" Color="#FFECECF2" />
    <SolidColorBrush x:Key="KpLine" Color="#3A202030" />

    <!-- accent -->
    <SolidColorBrush x:Key="KpAccent" Color="#FF3B63D8" />
    <SolidColorBrush x:Key="KpAccentSubtle" Color="#243B63D8" />
    <SolidColorBrush x:Key="KpOnAccent" Color="#FFFFFFFF" />

    <!-- text -->
    <SolidColorBrush x:Key="KpText" Color="#FF14141C" />
    <SolidColorBrush x:Key="KpTextBody" Color="#F02A2A38" />
    <SolidColorBrush x:Key="KpTextDim" Color="#B22A2A38" />
    <SolidColorBrush x:Key="KpTextFaint" Color="#802A2A38" />
    <SolidColorBrush x:Key="KpTextDisabled" Color="#592A2A38" />
    <SolidColorBrush x:Key="KpSectionLabel" Color="#A62A2A38" />
    <SolidColorBrush x:Key="KpZoneLabel" Color="#992A2A38" />

    <!-- status -->
    <SolidColorBrush x:Key="KpWarn" Color="#FFA9631A" />
    <SolidColorBrush x:Key="KpGood" Color="#FF1E7C34" />
    <SolidColorBrush x:Key="KpBad" Color="#FFC0392B" />

    <!-- overlay panel -->
    <SolidColorBrush x:Key="KpPanelBg" Color="#FFF7F7FB" />
    <SolidColorBrush x:Key="KpPanelBorder" Color="#33202030" />
    <!-- Hairline around a card and under its title: a card that is only a slightly
         lighter fill dissolves into the panel on a busy desktop. -->
    <SolidColorBrush x:Key="KpCardBorder" Color="#24202030" />
    <!-- Cards in the panel are opaque white: a translucent tint over a translucent panel
         left them almost invisible on a pale desktop. -->
    <SolidColorBrush x:Key="KpCardBg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="KpRailBg" Color="#121A1A2E" />
    <SolidColorBrush x:Key="KpHover" Color="#141A1A2E" />
    <SolidColorBrush x:Key="KpSeparator" Color="#26202030" />

    <!-- key caps -->
    <SolidColorBrush x:Key="KpCapText" Color="#FF23232E" />
    <SolidColorBrush x:Key="KpCapBorder" Color="#FFB9BFCC" />
    <LinearGradientBrush x:Key="KpCapBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#ECECF2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KpHeroBorder" Color="#FF3B63D8" />
    <LinearGradientBrush x:Key="KpHeroBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5B7EEA" Offset="0" />
        <GradientStop Color="#3B63D8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KpStar" Color="#FF3B63D8" />

    <!-- misc overlay -->
    <SolidColorBrush x:Key="KpHintBg" Color="#1F3B63D8" />
    <SolidColorBrush x:Key="KpHintText" Color="#FF1F3A6E" />
    <SolidColorBrush x:Key="KpSearchBg" Color="#0D1A1A2E" />
    <SolidColorBrush x:Key="KpSearchBorder" Color="#2E202030" />
    <SolidColorBrush x:Key="KpButtonBg" Color="#243B63D8" />
    <SolidColorBrush x:Key="KpButtonBorder" Color="#883B63D8" />

    <!-- provenance dots -->
    <SolidColorBrush x:Key="KpDotUser" Color="#FF3B63D8" />
    <SolidColorBrush x:Key="KpDotDownloaded" Color="#FF127C8C" />
    <SolidColorBrush x:Key="KpDotDiscovered" Color="#FF1E7C34" />

    <CornerRadius x:Key="KpRadius">8</CornerRadius>
</ResourceDictionary>
