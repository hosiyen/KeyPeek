<Window x:Class="KeyPeek.UI.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add app" Width="460" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource KpBg}" Foreground="{DynamicResource KpTextBody}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Intro" Grid.Row="0" Style="{StaticResource KpBody}" Margin="0,0,0,14"
                   Text="Create a shortcut definition for an app. The file opens in your editor afterwards." />

        <StackPanel x:Name="DisplayNameBlock" Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Display name" Style="{StaticResource KpBody}" FontSize="12" />
            <TextBox x:Name="DisplayNameBox" Style="{StaticResource KpTextBox}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock x:Name="ProcessLabel" Text="Process name (no .exe)" Style="{StaticResource KpBody}"
                       FontSize="12" />
            <TextBox x:Name="ProcessBox" Style="{StaticResource KpTextBox}" Margin="0,4,0,0"
                     TextChanged="Process_TextChanged" />
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource KpSurface}"
                BorderBrush="{DynamicResource KpLine}" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Running apps" Style="{StaticResource KpHint}"
                           Margin="12,8,0,4" />
                <ListBox x:Name="ProcessList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource KpTextBody}" FontSize="13"
                         SelectionChanged="ProcessList_SelectionChanged" Margin="4,0,4,6" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Add" Style="{StaticResource KpButtonPrimary}"
                    Click="Ok_Click" IsDefault="True" IsEnabled="False" />
            <Button Content="Cancel" Style="{StaticResource KpButton}" Margin="8,0,0,0"
                    Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
