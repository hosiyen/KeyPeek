<Window x:Class="KeyPeek.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KeyPeek.UI"
        Title="Welcome to KeyPeek" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource KpBg}" Foreground="{DynamicResource KpTextBody}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24,20,24,18">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Image Source="/Assets/KeyPeek.ico" Width="28" Height="28"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="KeyPeek is running" Style="{StaticResource KpPageTitle}"
                       VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource KpHint}" Margin="0,0,0,16"
                   Text="It sits in the tray and stays out of your way until you ask for it." />

        <!-- Step 1: the whole product in one line -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:KeyCapsElement x:Name="HoldCap" Grid.Column="0" VerticalAlignment="Center"
                               Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Hold it for half a second" Style="{StaticResource KpBody}" />
                <TextBlock Style="{StaticResource KpHint}"
                           Text="The shortcuts of whatever app you're in appear. Let go and they're gone." />
            </StackPanel>
        </Grid>

        <!-- Step 2 -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE8B0;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{DynamicResource KpAccent}" Width="28" TextAlignment="Center"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Click a row to run it" Style="{StaticResource KpBody}" />
                <TextBlock Style="{StaticResource KpHint}"
                           Text="KeyPeek presses the shortcut for you in the app underneath." />
            </StackPanel>
        </Grid>

        <!-- Step 3 -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{DynamicResource KpAccent}" Width="28" TextAlignment="Center"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Everything else lives in the tray icon" Style="{StaticResource KpBody}" />
                <TextBlock Style="{StaticResource KpHint}"
                           Text="Double-click it for settings, the shortcut library and conflicts." />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource KpHint}" Margin="0,0,0,14" TextWrapping="Wrap"
                   Text="KeyPeek watches for held modifier keys only. It never records what you type, and nothing leaves this machine." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open settings" Style="{StaticResource KpButton}"
                    Margin="0,0,8,0" Click="OpenSettings_Click" />
            <Button Content="Got it" Style="{StaticResource KpButtonPrimary}"
                    IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
